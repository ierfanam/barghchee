# === Core AI (required) ===
# Google Gemini API key used for the Live Audio API bridge.
GEMINI_API_KEY=

# === Telephony (optional, required only for real PSTN calls via Twilio) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === Server runtime (optional) ===
# Port the HTTP/WebSocket server listens on (default: 3000).
PORT=3000
# Host/interface to bind (default: 0.0.0.0).
HOST=0.0.0.0
# Set to "production" to serve the pre-built dist/ assets instead of the Vite dev server.
NODE_ENV=development
# Comma-separated list of allowed CORS origins. Leave empty to allow all (dev only).
CORS_ORIGIN=

# === SIP / Kamailio gateway (optional) ===
# JSON-RPC endpoint of the Kamailio SIP proxy used for subscriber location dumps.
KAMAILIO_RPC_URL=http://localhost:5060/RPC
