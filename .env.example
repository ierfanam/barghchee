# Realtime provider
REALTIME_PROVIDER=openai
# BARghCHEE compatibility alias; resolves to a supported OpenAI Realtime model.
REALTIME_MODEL=gpt-4o-live

# OpenAI Realtime API (server-side only)
OPENAI_API_KEY=

# Gemini Live fallback
GEMINI_API_KEY=

# Optional Twilio/PBX configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
