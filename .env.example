GEMINI_API_KEY=

# Standalone SIP telephony (optional - works without any external service)
# Route outbound calls to real mobile numbers via any SIP trunk (free tiers available)
SIP_PROXY_HOST=
SIP_PROXY_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=
SIP_FROM_URI=

# Legacy Twilio keys are no longer required - the built-in standalone telephony engine is used instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
