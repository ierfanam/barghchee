# The telephony service is fully standalone and needs NO external or paid service.
# Outbound AI debt-collection calls run on the built-in SIP/RTP stack, the local
# conversation engine and the local espeak TTS. No API keys are required.

# Optional: route outbound SIP calls to real mobile numbers via any SIP trunk
SIP_PROXY_HOST=
SIP_PROXY_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=
SIP_FROM_URI=

# Optional: GSM modem for real mobile calls (AT command driver)
GSM_MODEM_PORT=
GSM_MODEM_BAUDRATE=115200
GSM_MODEM_AUDIO_PORT=
GSM_MODEM_AUDIO_BAUDRATE=115200
GSM_MODEM_AUDIO_RATE=16000

# Optional: path to espeak binary for local Persian TTS (default: espeak)
ESPEAK_PATH=espeak

# Legacy Twilio keys are no longer required - the built-in standalone telephony engine is used instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The web chat assistant (separate from telephony) uses the Gemini Live proxy at /live
GEMINI_API_KEY=
