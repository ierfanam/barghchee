{
  "name": "audio-orb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "echo 'Bypass TS bug'",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:realtime": "tsx server/realtime/fullDuplexState.test.ts && tsx server/realtime/runtimeConfig.test.ts && tsx server/realtime/toolPolicy.test.ts && tsx server/realtime/eventNormalizer.test.ts && tsx server/realtime/config.test.ts && tsx server/realtime/productionGate.test.ts",
    "verify:realtime": "npm run typecheck && npm run test:realtime && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@lit/context": "^1.1.5",
    "@twilio/voice-sdk": "^2.18.3",
    "@types/express": "^5.0.6",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "lit": "^3.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "three": "^0.176.0",
    "tsx": "^4.22.4",
    "twilio": "^6.0.2",
    "twilio": "^6.0.2",
    "three": "^0.176.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
